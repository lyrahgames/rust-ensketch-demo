{
  "name": "graphics-research-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "wasm:build": "wasm-pack build ../../crates/script-js --target web --out-dir ../../pkg --out-name script_js --release",
    "dev": "pnpm wasm:build && vite --config vite.config.js --open /apps/web/",
    "build": "pnpm wasm:build && vite --config vite.config.js build",
    "preview": "vite --config vite.config.js preview --open /apps/web/"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "wasm-pack": "0.15.0"
  }
}
